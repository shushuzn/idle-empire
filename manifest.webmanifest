{
  "id": "./",
  "name": "放置帝国 Idle Empire",
  "short_name": "放置帝国",
  "description": "纯前端放置/增量游戏：建筑、升级、Boss、成就、转生与剧情档案。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0f18",
  "theme_color": "#0f1320",
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "lang": "zh-CN",
  "dir": "ltr",
  "categories": [
    "games",
    "entertainment"
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "裂隙纪事",
